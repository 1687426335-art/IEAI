#import <UIKit/UIKit.h>
#import <Foundation/Foundation.h>
#import <objc/runtime.h>
#import <substrate.h>

// ============================================================
// 全局变量
// ============================================================
static NSInteger g_remainingCards = 0;
static NSString *g_myCards = @"--";
static UIWindow *g_floatWindow = nil;

// ============================================================
// 悬浮窗控制器
// ============================================================
@interface FloatViewController : UIViewController
@property (nonatomic, strong) UIButton *floatButton;
@property (nonatomic, strong) UIView *panelView;
@property (nonatomic, strong) UILabel *infoLabel;
@property (nonatomic, assign) BOOL isExpanded;
@end

@implementation FloatViewController

- (void)loadView {
    self.view = [[UIView alloc] initWithFrame:[UIScreen mainScreen].bounds];
    self.view.backgroundColor = [UIColor clearColor];
    self.view.userInteractionEnabled = YES;
}

- (void)viewDidLoad {
    [super viewDidLoad];
    [self setupUI];
    [self setupGestures];
}

- (void)setupUI {
    // 悬浮按钮
    self.floatButton = [UIButton buttonWithType:UIButtonTypeCustom];
    self.floatButton.frame = CGRectMake(20, 200, 55, 55);
    self.floatButton.backgroundColor = [UIColor colorWithRed:0.15 green:0.15 blue:0.35 alpha:0.85];
    self.floatButton.layer.cornerRadius = 27.5;
    self.floatButton.layer.borderWidth = 2;
    self.floatButton.layer.borderColor = [UIColor colorWithRed:0.4 green:0.7 blue:1.0 alpha:1.0].CGColor;
    self.floatButton.layer.shadowColor = [UIColor blackColor].CGColor;
    self.floatButton.layer.shadowOpacity = 0.6;
    self.floatButton.layer.shadowOffset = CGSizeMake(0, 3);
    self.floatButton.layer.shadowRadius = 5;
    [self.floatButton setTitle:@"🃏" forState:UIControlStateNormal];
    self.floatButton.titleLabel.font = [UIFont systemFontOfSize:28];
    [self.floatButton addTarget:self action:@selector(togglePanel) forControlEvents:UIControlEventTouchUpInside];
    [self.view addSubview:self.floatButton];
    
    // 展开面板
    self.panelView = [[UIView alloc] initWithFrame:CGRectMake(20, 260, 170, 130)];
    self.panelView.backgroundColor = [UIColor colorWithWhite:0.1 alpha:0.92];
    self.panelView.layer.cornerRadius = 12;
    self.panelView.layer.borderWidth = 1;
    self.panelView.layer.borderColor = [UIColor colorWithRed:0.3 green:0.5 blue:0.8 alpha:1.0].CGColor;
    self.panelView.alpha = 0.0;
    self.panelView.hidden = YES;
    [self.view addSubview:self.panelView];
    
    self.infoLabel = [[UILabel alloc] initWithFrame:CGRectMake(15, 15, 140, 90)];
    self.infoLabel.textColor = [UIColor whiteColor];
    self.infoLabel.font = [UIFont systemFontOfSize:13 weight:UIFontWeightMedium];
    self.infoLabel.numberOfLines = 0;
    self.infoLabel.text = @"🃏 记牌器\n剩余牌: --\n我的牌: --";
    [self.panelView addSubview:self.infoLabel];
    
    UIButton *closeBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    closeBtn.frame = CGRectMake(130, 5, 30, 30);
    [closeBtn setTitle:@"✕" forState:UIControlStateNormal];
    [closeBtn setTitleColor:[UIColor redColor] forState:UIControlStateNormal];
    closeBtn.titleLabel.font = [UIFont boldSystemFontOfSize:16];
    [closeBtn addTarget:self action:@selector(closeWindow) forControlEvents:UIControlEventTouchUpInside];
    [self.panelView addSubview:closeBtn];
}

- (void)setupGestures {
    UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(handlePan:)];
    [self.floatButton addGestureRecognizer:pan];
}

- (void)handlePan:(UIPanGestureRecognizer *)gesture {
    CGPoint translation = [gesture translationInView:self.view];
    CGPoint center = self.floatButton.center;
    center.x += translation.x;
    center.y += translation.y;
    CGFloat half = self.floatButton.frame.size.width / 2;
    center.x = MAX(half, MIN(self.view.bounds.size.width - half, center.x));
    center.y = MAX(half + 40, MIN(self.view.bounds.size.height - half - 40, center.y));
    self.floatButton.center = center;
    [gesture setTranslation:CGPointZero inView:self.view];
    if (gesture.state == UIGestureRecognizerStateBegan) {
        [self collapsePanel];
    }
}

- (void)togglePanel {
    self.isExpanded ? [self collapsePanel] : [self expandPanel];
}

- (void)expandPanel {
    self.isExpanded = YES;
    self.panelView.hidden = NO;
    [UIView animateWithDuration:0.25 animations:^{
        self.panelView.alpha = 1.0;
    }];
    [self updateInfo];
}

- (void)collapsePanel {
    self.isExpanded = NO;
    [UIView animateWithDuration:0.25 animations:^{
        self.panelView.alpha = 0.0;
    } completion:^(BOOL finished) {
        self.panelView.hidden = YES;
    }];
}

- (void)closeWindow {
    [self.view removeFromSuperview];
    g_floatWindow = nil;
}

- (void)updateInfo {
    dispatch_async(dispatch_get_main_queue(), ^{
        self.infoLabel.text = [NSString stringWithFormat:@"🃏 记牌器\n剩余牌: %ld张\n我的牌: %@", (long)g_remainingCards, g_myCards ?: @"--"];
    });
}

@end

// ============================================================
// 创建悬浮窗入口
// ============================================================
static void CreateFloatWindow() {
    if (g_floatWindow) return;
    UIWindow *window = [[UIWindow alloc] initWithFrame:[UIScreen mainScreen].bounds];
    window.windowLevel = UIWindowLevelStatusBar + 100;
    window.backgroundColor = [UIColor clearColor];
    window.rootViewController = [[FloatViewController alloc] init];
    window.hidden = NO;
    g_floatWindow = window;
}

// ============================================================
// 记牌器数据获取（需要你根据真实类名修改）
// 用 class-dump 导出游戏头文件，替换下面的占位符
// ============================================================
// 假设游戏有以下几个类：
// @interface GameModel : NSObject
// - (NSInteger)remainingCardCount;
// - (NSArray *)myCards;
// @end

// 真实的类名需要用 class-dump 获得

%hook GameModel
- (NSInteger)remainingCardCount {
    NSInteger count = %orig;
    g_remainingCards = count;
    return count;
}
- (NSArray *)myCards {
    NSArray *cards = %orig;
    g_myCards = [cards componentsJoinedByString:@" "];
    return cards;
}
%end

// ============================================================
// 初始化
// ============================================================
%ctor {
    // 延迟3秒创建，等游戏加载
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        CreateFloatWindow();
        UIAlertView *alert = [[UIAlertView alloc] initWithTitle:@"✅ 注入成功" 
                                                         message:@"悬浮窗已加载\n点击🃏展开记牌器" 
                                                        delegate:nil 
                                               cancelButtonTitle:@"OK" 
                                               otherButtonTitles:nil];
        [alert show];
    });
}